# Google (for Sheets + Drive bonus)
GOOGLE_SERVICE_ACCOUNT_JSON=./credentials/service_account.json
GOOGLE_SHEET_ID=
GOOGLE_DRIVE_FOLDER_ID=

# App
PORT=8000
OUTPUT_DIR=./output/reports
